+    return gfx::Vector2d();
+  }
+  ChromeClient& chrome_client = frame->GetPage()->GetChromeClient();
+  const gfx::Rect window = chrome_client.RootWindowRect(*frame);
+  const gfx::Rect screen = chrome_client.GetScreenInfo(*frame).rect;
+  const int x = std::clamp(window.x() - screen.x(), 0,
+                           std::max(0, forced->width - window.width()));
+  const int y = std::clamp(window.y() - screen.y(), 0,
