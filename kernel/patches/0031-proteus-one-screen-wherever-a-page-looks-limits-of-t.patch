+
+// Proteus: the window is told to be where it is on the machine's screen it is
+// on, in the profile's units and kept inside the profile's screen as far as
+// its size allows; every other place on the screen keeps its distance to it.
+gfx::PointF LocalDOMWindow::ProteusScreenPoint(const gfx::PointF& real) const {
+  const auto& forced = base::proteus::GetConfig().screen;
+  LocalFrame* frame = GetFrame();
+  if (!forced || !frame || !frame->GetPage()) {
+    return real;
+  }
+  ChromeClient& chrome_client = frame->GetPage()->GetChromeClient();
+  const gfx::Rect window = chrome_client.RootWindowRect(*frame);
+  const gfx::Rect screen = chrome_client.GetScreenInfo(*frame).rect;
+  const float scale = ProteusScreenScale();
+  const gfx::SizeF outer = ProteusOuterSize();
+  const float x =
+      std::clamp((window.x() - screen.x()) * scale, 0.f,
+                 std::max(0.f, forced->width - outer.width()));
+  const float y =
+      std::clamp((window.y() - screen.y()) * scale, 0.f,
+                 std::max(0.f, forced->height - outer.height()));
+  // The window's bars are as thick as they are; the page begins after them
+  // and is measured in its own pixels.
+  const gfx::Rect view = ProteusViewOnScreen(frame);
+  if (view.IsEmpty()) {
+    return gfx::PointF(x + (real.x() - window.x()) * scale,
+                       y + (real.y() - window.y()) * scale);
