+
+gfx::Size LocalDOMWindow::ProteusMachineOuterSize(int width, int height) const {
+  LocalFrame* frame = GetFrame();
+  const float scale = ProteusScreenScale();
+  if (scale == 1 || !frame || !frame->GetPage()) {
+    return gfx::Size(width, height);
