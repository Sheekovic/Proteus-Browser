+// Proteus: a frame of |size| as one of |to|.
+static std::vector<uint8_t> ProteusScaleFrame(const std::vector<uint8_t>& from,
+                                              const gfx::Size& size,
+                                              const gfx::Size& to) {
+  int width = size.width();
+  int height = size.height();
+  if (width * to.height() > height * to.width()) {
+    width = (height * to.width() / to.height()) & ~1;
+  } else {
+    height = (width * to.height() / to.width()) & ~1;
+  }
+  const int left = ((size.width() - width) / 2) & ~1;
+  const int top = ((size.height() - height) / 2) & ~1;
+  const int stride = size.width();
+  const int half = (size.width() + 1) / 2;
+  const size_t luma = static_cast<size_t>(stride) * size.height();
+  const size_t chroma =
+      static_cast<size_t>(half) * ((size.height() + 1) / 2);
+  if (width <= 0 || height <= 0 || from.size() < luma + 2 * chroma) {
+    return from;
+  }
+  const int to_half = (to.width() + 1) / 2;
+  const size_t to_luma = static_cast<size_t>(to.width()) * to.height();
+  const size_t to_chroma =
+      static_cast<size_t>(to_half) * ((to.height() + 1) / 2);
+  std::vector<uint8_t> scaled(to_luma + 2 * to_chroma);
+  const size_t first = static_cast<size_t>(top) * stride + left;
+  const size_t first_chroma = static_cast<size_t>(top / 2) * half + left / 2;
+  UNSAFE_TODO(libyuv::I420Scale(
+      from.data() + first, stride, from.data() + luma + first_chroma, half,
+      from.data() + luma + chroma + first_chroma, half, width, height,
+      scaled.data(), to.width(), scaled.data() + to_luma, to_half,
+      scaled.data() + to_luma + to_chroma, to_half, to.width(), to.height(),
+      libyuv::kFilterBilinear));
+  return scaled;
+}
