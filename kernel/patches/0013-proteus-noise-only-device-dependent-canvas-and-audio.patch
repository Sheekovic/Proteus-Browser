 void BaseRenderingContext2D::ResetInternal() {
   Canvas2DRecorderContext::ResetInternal();
   clear_frame_ = true;
+  proteus_device_dependent_ = false;
+}
+
+void BaseRenderingContext2D::ProteusNoteImageSource(CanvasImageSource* source,
+                                                    bool is_svg) {
+  if (proteus_device_dependent_) {
+    return;
+  }
+  // A decoded bitmap image is the same everywhere.
+  if (source->IsImageElement() && !is_svg) {
+    return;
+  }
+  // Another canvas passes on what it holds.
+  CanvasRenderingContext* context = nullptr;
+  if (source->IsCanvasElement()) {
+    context = static_cast<HTMLCanvasElement*>(source)->RenderingContext();
+  } else if (source->IsOffscreenCanvas()) {
+    context = static_cast<OffscreenCanvas*>(source)->RenderingContext();
+  } else {
+    proteus_device_dependent_ = true;
+    return;
+  }
+  if (context && context->ProteusHasDeviceDependentContent()) {
+    proteus_device_dependent_ = true;
+  }
 }
 
 CanvasRenderingContext2DSettings* BaseRenderingContext2D::getContextAttributes()
@@ -928,8 +953,9 @@ ImageData* BaseRenderingContext2D::getImageDataInternal(
 
     SkPixmap image_data_pixmap = image_data->GetSkPixmap();
     const bool read_pixels_successful =
-        ProteusReadNoisedCanvasPixels(snapshot->PaintImageForCurrentFrame(),
-                                      image_data_pixmap, sx, sy) ||
+        (proteus_device_dependent_ &&
+         ProteusReadNoisedCanvasPixels(snapshot->PaintImageForCurrentFrame(),
+                                       image_data_pixmap, sx, sy)) ||
         snapshot->PaintImageForCurrentFrame().readPixels(
             image_data_pixmap.info(), image_data_pixmap.writable_addr(),
             image_data_pixmap.rowBytes(), sx, sy);
