From 5dbcf5d4cfbda35d667a4340b62773752ef3ba02 Mon Sep 17 00:00:00 2001
From: Proteus <proteus@localhost>
Date: Mon, 16 Nov 2026 03:19:26 +0000
Subject: [PATCH 18/33] proteus: a spoofed WebGL vendor or renderer costs what
 a real one does

---
 .../renderer/modules/webgl/webgl_rendering_context_base.cc      | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
index 9add2191d4..9604982f10 100644
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -4227,6 +4227,7 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
         if (const std::string& forced =
                 base::proteus::GetConfig().webgl_renderer;
             !forced.empty()) {
+          ContextGL()->GetString(GL_RENDERER);
           return WebGLAny(script_state,
                           String::FromUtf8(base::as_byte_span(forced)));
         }
@@ -4242,6 +4243,7 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
         if (const std::string& forced =
                 base::proteus::GetConfig().webgl_vendor;
             !forced.empty()) {
+          ContextGL()->GetString(GL_VENDOR);
           return WebGLAny(script_state,
                           String::FromUtf8(base::as_byte_span(forced)));
         }
-- 
