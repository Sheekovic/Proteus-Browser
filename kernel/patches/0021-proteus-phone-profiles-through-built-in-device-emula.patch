   return WebLocalFrameImpl::GetNullFrameReasonForBug1139104(local_frame);
 }
 
+// Proteus: turns on phone emulation for |frame| if it is still the main frame
+// of a live page.
+static void ProteusApplyMobileEmulation(LocalFrame* frame) {
+  if (!frame || !frame->GetPage() || !frame->DomWindow() ||
+      !frame->IsOutermostMainFrame()) {
+    return;
+  }
+  WebViewImpl* view = frame->GetPage()->GetChromeClient().GetWebView();
+  if (!view || !view->MainFrameImpl() ||
+      view->MainFrameImpl()->GetFrame() != frame ||
+      !view->MainFrameImpl()->FrameWidgetImpl()) {
+    return;
+  }
+  if (const base::proteus::Config& proteus = base::proteus::GetConfig();
+      proteus.mobile && view->does_composite()) {
+    DeviceEmulationParams params;
+    params.screen_type = mojom::EmulatedScreenType::kMobile;
+    if (proteus.screen) {
+      params.screen_size =
+          gfx::Size(proteus.screen->width, proteus.screen->height);
+    }
+    params.view_size =
+        gfx::Size(proteus.mobile_view_width, proteus.mobile_view_height);
+    params.device_scale_factor =
+        static_cast<float>(proteus.mobile_device_scale_factor);
+    params.screen_orientation_type =
+        display::mojom::ScreenOrientation::kPortraitPrimary;
+    params.force_viewport_meta = true;
+    params.force_android_overlay_scrollbar = true;
+    params.force_text_size_adjust = true;
+    view->EnableDeviceEmulation(params);
+    view->GetDevToolsEmulator()->SetTouchEventEmulationEnabled(
+        true, proteus.mobile_max_touch_points);
+  }
+}
+
 void WebViewImpl::DidAttachLocalMainFrame() {
   DCHECK(MainFrameImpl());
   DCHECK(!remote_main_frame_host_remote_);
@@ -2207,6 +2246,12 @@ void WebViewImpl::DidAttachLocalMainFrame() {
       local_frame->View()->InitializeRootScroller();
     }
   }
+
+  if (base::proteus::GetConfig().mobile) {
+    local_frame->GetTaskRunner(TaskType::kInternalDefault)
+        ->PostTask(FROM_HERE, BindOnce(&ProteusApplyMobileEmulation,
+                                       WrapWeakPersistent(local_frame)));
+  }
 }
 
 void WebViewImpl::DidAttachRemoteMainFrame(
