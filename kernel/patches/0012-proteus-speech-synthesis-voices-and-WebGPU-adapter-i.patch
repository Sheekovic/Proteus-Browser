From 0ddec2214b1ea2ae6e7bf3049e6afe266fb7ddf0 Mon Sep 17 00:00:00 2001
From: Proteus <proteus@localhost>
Date: Sun, 15 Nov 2026 17:20:47 +0000
Subject: [PATCH 12/33] proteus: speech synthesis voices and WebGPU adapter
 info from the profile

---
 base/proteus/proteus_config.cc                | 25 ++++++++++++++++
 base/proteus/proteus_config.h                 | 22 ++++++++++++++
 .../modules/speech/speech_synthesis.cc        | 30 +++++++++++++++++++
 .../modules/webgpu/gpu_adapter_info.cc        | 18 +++++++++--
 4 files changed, 93 insertions(+), 2 deletions(-)

diff --git a/base/proteus/proteus_config.cc b/base/proteus/proteus_config.cc
index 91fb084998..23a1ebb838 100644
--- a/base/proteus/proteus_config.cc
+++ b/base/proteus/proteus_config.cc
@@ -200,6 +200,26 @@ Config LoadConfig() {
   config.webrtc_public_ip = StringOrEmpty(*dict, "webRtcPublicIp");
   config.canvas_noise = dict->FindBool("canvasNoise").value_or(false);
   config.audio_noise = dict->FindBool("audioNoise").value_or(false);
+  if (const DictValue* webgpu = dict->FindDict("webgpu")) {
+    config.webgpu_vendor = StringOrEmpty(*webgpu, "vendor");
+    config.webgpu_architecture = StringOrEmpty(*webgpu, "architecture");
+  }
+  if (const ListValue* voices = dict->FindList("voices")) {
+    for (const Value& item : *voices) {
+      const DictValue* entry = item.GetIfDict();
+      if (!entry) {
+        continue;
+      }
+      Voice voice;
+      voice.name = StringOrEmpty(*entry, "name");
+      voice.lang = StringOrEmpty(*entry, "lang");
+      voice.local = entry->FindBool("local").value_or(true);
+      voice.is_default = entry->FindBool("default").value_or(false);
+      if (!voice.name.empty()) {
+        config.voices.push_back(std::move(voice));
+      }
+    }
+  }
   if (const std::string* value = dict->FindString("webglVendor")) {
     config.webgl_vendor = *value;
   }
@@ -211,6 +231,11 @@ Config LoadConfig() {
 
 }  // namespace
 
+Voice::Voice() = default;
+Voice::Voice(const Voice&) = default;
+Voice& Voice::operator=(const Voice&) = default;
+Voice::~Voice() = default;
+
 FontAlias::FontAlias() = default;
 FontAlias::FontAlias(const FontAlias&) = default;
 FontAlias& FontAlias::operator=(const FontAlias&) = default;
diff --git a/base/proteus/proteus_config.h b/base/proteus/proteus_config.h
index 849b6fbea3..ff0f1ea50e 100644
--- a/base/proteus/proteus_config.h
+++ b/base/proteus/proteus_config.h
@@ -66,6 +66,19 @@ struct BASE_EXPORT FontAlias {
   std::vector<std::string> substitutes;
 };
 
+// One entry of speechSynthesis.getVoices().
+struct BASE_EXPORT Voice {
+  Voice();
+  Voice(const Voice&);
+  Voice& operator=(const Voice&);
+  ~Voice();
+
+  std::string name;
+  std::string lang;       // BCP 47 tag, e.g. "en-US"
+  bool local = true;      // localService
+  bool is_default = false;
+};
+
 // window.screen and the device-width / device-height media features, in CSS
 // pixels.
 struct BASE_EXPORT ScreenData {
@@ -151,6 +164,15 @@ struct BASE_EXPORT Config {
   std::string webgl_vendor;
   std::string webgl_renderer;
 
+  // GPUAdapterInfo.vendor / .architecture ("intel" / "gen-12lp"), which must
+  // agree with the WebGL strings. Empty means "report the real GPU".
+  std::string webgpu_vendor;
+  std::string webgpu_architecture;
+
+  // The speech synthesis voices to report; they differ by operating system.
+  // Empty means "report this machine's voices".
+  std::vector<Voice> voices;
+
   // Base64 form of the source JSON, forwarded to child processes.
   std::string serialized;
 };
diff --git a/third_party/blink/renderer/modules/speech/speech_synthesis.cc b/third_party/blink/renderer/modules/speech/speech_synthesis.cc
index 891a81543b..cb6dbc870b 100644
--- a/third_party/blink/renderer/modules/speech/speech_synthesis.cc
+++ b/third_party/blink/renderer/modules/speech/speech_synthesis.cc
@@ -26,6 +26,10 @@
 #include "third_party/blink/renderer/modules/speech/speech_synthesis.h"
 
 #include <tuple>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/proteus/proteus_config.h"
 
 #include "build/build_config.h"
 #include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
@@ -82,9 +86,32 @@ SpeechSynthesis::SpeechSynthesis(LocalDOMWindow& window)
       receiver_(this, &window),
       mojom_synthesis_(&window) {}
 
+// Proteus: fills |list| with the profile's voices. Returns false, leaving
+// |list| alone, when the profile does not define any.
+static bool ProteusFillVoiceList(
+    HeapVector<Member<SpeechSynthesisVoice>>& list) {
+  const auto& voices = base::proteus::GetConfig().voices;
+  if (voices.empty()) {
+    return false;
+  }
+  for (const base::proteus::Voice& voice : voices) {
+    const String name = String::FromUtf8(base::as_byte_span(voice.name));
+    list.push_back(MakeGarbageCollected<SpeechSynthesisVoice>(
+        mojom::blink::SpeechSynthesisVoice::New(
+            /*voice_uri=*/name, name,
+            String::FromUtf8(base::as_byte_span(voice.lang)), voice.local,
+            voice.is_default)));
+  }
+  return true;
+}
+
 void SpeechSynthesis::OnSetVoiceList(
     Vector<mojom::blink::SpeechSynthesisVoicePtr> mojom_voices) {
   voice_list_.clear();
+  if (ProteusFillVoiceList(voice_list_)) {
+    VoicesDidChange();
+    return;
+  }
   for (auto& mojom_voice : mojom_voices) {
     voice_list_.push_back(
         MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
@@ -95,6 +122,9 @@ void SpeechSynthesis::OnSetVoiceList(
 const HeapVector<Member<SpeechSynthesisVoice>>& SpeechSynthesis::getVoices() {
   // Kick off initialization here to ensure voice list gets populated.
   std::ignore = TryEnsureMojomSynthesis();
+  if (voice_list_.empty()) {
+    ProteusFillVoiceList(voice_list_);
+  }
   return voice_list_;
 }
 
diff --git a/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc b/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
index 9d155705c1..68f601f3ab 100644
--- a/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
+++ b/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
@@ -4,11 +4,23 @@
 
 #include "third_party/blink/renderer/modules/webgpu/gpu_adapter_info.h"
 
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/proteus/proteus_config.h"
+
 #include "third_party/blink/renderer/modules/webgpu/gpu_memory_heap_info.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_subgroup_matrix_config.h"
 
 namespace blink {
 
+// Proteus: |real| unless the profile overrides this field.
+static String ProteusAdapterField(const String& real,
+                                  const std::string& forced) {
+  return forced.empty() ? real
+                        : String::FromUtf8(base::as_byte_span(forced));
+}
+
 GPUAdapterInfo::GPUAdapterInfo(const String& vendor,
                                const String& architecture,
                                uint32_t subgroup_min_size,
@@ -22,8 +34,10 @@ GPUAdapterInfo::GPUAdapterInfo(const String& vendor,
                                const std::optional<uint32_t> d3d_shader_model,
                                const std::optional<uint32_t> vk_driver_version,
                                const String& power_preference)
-    : vendor_(vendor),
-      architecture_(architecture),
+    : vendor_(ProteusAdapterField(
+          vendor, base::proteus::GetConfig().webgpu_vendor)),
+      architecture_(ProteusAdapterField(
+          architecture, base::proteus::GetConfig().webgpu_architecture)),
       subgroup_min_size_(subgroup_min_size),
       subgroup_max_size_(subgroup_max_size),
       is_fallback_adapter_(is_fallback_adapter),
