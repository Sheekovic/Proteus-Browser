 #include "base/strings/utf_string_conversions.h"
 #include "base/trace_event/trace_event.h"
@@ -33,8 +36,36 @@ IDWriteFactory* g_direct_write_factory = nullptr;
 // font. Usually this is the Ahem.ttf font. Leaked at shutdown.
 std::vector<base::FilePath>* g_sideloaded_fonts = nullptr;
 
+// Proteus: the fonts of the profile's folder join the side-loaded ones.
+void ProteusSideLoadFolder() {
+  static bool done = false;
+  if (done) {
+    return;
+  }
+  done = true;
+  const std::string& font_dir = base::proteus::GetConfig().font_dir;
+  if (font_dir.empty()) {
+    return;
+  }
+  base::FileEnumerator files(base::FilePath::FromUTF8Unsafe(font_dir),
+                             /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath file = files.Next(); !file.empty();
+       file = files.Next()) {
+    if (file.MatchesExtension(FILE_PATH_LITERAL(".ttf")) ||
+        file.MatchesExtension(FILE_PATH_LITERAL(".otf")) ||
+        file.MatchesExtension(FILE_PATH_LITERAL(".ttc"))) {
+      if (!g_sideloaded_fonts) {
+        g_sideloaded_fonts = new std::vector<base::FilePath>();
+      }
+      g_sideloaded_fonts->push_back(file);
+    }
+  }
+}
+
 bool GetFontCollection(Microsoft::WRL::ComPtr<IDWriteFactory>& factory,
                        IDWriteFontCollection** collection) {
+  ProteusSideLoadFolder();
   if (!g_sideloaded_fonts) {
     // Normal path - The DirectWrite font manager will use the system's font
     // collection with no sideloading when passed `nullptr` for the collection.
@@ -125,6 +156,7 @@ void SideLoadFontForTesting(base::FilePath path) {
 }
 
 const std::vector<base::FilePath>* GetSideloadedFontsForTesting() {
+  ProteusSideLoadFolder();
   return g_sideloaded_fonts;
 }
 
