 namespace {
 
+// Proteus: device pixels to a CSS pixel as the machine has them: what a length
+// that came in the machine's units was multiplied by. With a profile's scale
+// that is the machine's scale times the user's zoom, the zoom being what the
+// page is laid out at over the profile's scale: exactly 1 without zoom.
+double ProteusMachinePixelRatio(const LocalDOMWindow& window) {
+  const double ratio = window.devicePixelRatio();
+  const auto& forced = base::proteus::GetConfig().screen;
+  LocalFrame* frame = window.GetFrame();
+  if (!forced || forced->pixel_ratio <= 0 || !frame || !frame->GetPage()) {
+    return ratio;
+  }
+  return frame->GetPage()
+             ->GetChromeClient()
+             .GetScreenInfo(*frame)
+             .device_scale_factor *
+         (ratio / forced->pixel_ratio);
+}
+
 unsigned ConvertDeltaMode(const WebMouseWheelEvent& event) {
   // WebMouseWheelEvent only supports these units for the delta.
   DCHECK(event.delta_units == ui::ScrollGranularity::kScrollByPage ||
@@ -107,10 +131,8 @@ WheelEvent::WheelEvent(const WebMouseWheelEvent& event, LocalDOMWindow& window)
       wheel_delta_(
           (event.wheel_ticks_x * kTickMultiplier) / window.devicePixelRatio(),
           (event.wheel_ticks_y * kTickMultiplier) / window.devicePixelRatio()),
-      delta_x_(-event.DeltaXInRootFrame() / window.devicePixelRatio() /
-               window.ProteusScreenScale()),
-      delta_y_(-event.DeltaYInRootFrame() / window.devicePixelRatio() /
-               window.ProteusScreenScale()),
+      delta_x_(-event.DeltaXInRootFrame() / ProteusMachinePixelRatio(window)),
+      delta_y_(-event.DeltaYInRootFrame() / ProteusMachinePixelRatio(window)),
       delta_z_(0),
       delta_mode_(ConvertDeltaMode(event)),
       native_event_(event),
