+// Proteus: the capabilities of the profile's graphics card.
+static const base::proteus::Config::WebGLCaps& ProteusCaps(bool webgl2) {
+  return base::proteus::GetConfig().webgl_caps[webgl2 ? 1 : 0];
+}
+
+static const std::vector<double>* ProteusFindParameter(bool webgl2,
+                                                       GLenum pname) {
+  for (const auto& [name, numbers] : ProteusCaps(webgl2).params) {
+    if (name == pname) {
+      return &numbers;
+    }
+  }
+  return nullptr;
+}
+
+bool WebGLRenderingContextBase::ProteusHasForcedParameter(bool webgl2,
+                                                          GLenum pname) {
+  return ProteusFindParameter(webgl2, pname) != nullptr;
+}
+
+ScriptValue WebGLRenderingContextBase::ProteusForceParameter(
+    ScriptState* script_state,
+    bool webgl2,
+    GLenum pname,
+    ScriptValue stock) {
+  const std::vector<double>* forced = ProteusFindParameter(webgl2, pname);
+  if (!forced || stock.IsEmpty()) {
+    return stock;
+  }
+  v8::Isolate* isolate = script_state->GetIsolate();
+  v8::Local<v8::Value> value = stock.V8Value();
+  if (value->IsNumber() && forced->size() == 1) {
+    return ScriptValue(isolate, v8::Number::New(isolate, forced->front()));
+  }
+  if (value->IsInt32Array() &&
+      value.As<v8::Int32Array>()->Length() == forced->size()) {
+    std::vector<int32_t> numbers;
+    for (double number : *forced) {
+      numbers.push_back(base::saturated_cast<int32_t>(number));
+    }
+    return WebGLAny(script_state,
+                    DOMInt32Array::Create(base::span<const int32_t>(numbers)));
+  }
+  if (value->IsFloat32Array() &&
+      value.As<v8::Float32Array>()->Length() == forced->size()) {
+    std::vector<float> numbers;
+    for (double number : *forced) {
+      numbers.push_back(static_cast<float>(number));
+    }
+    return WebGLAny(script_state,
+                    DOMFloat32Array::Create(base::span<const float>(numbers)));
+  }
+  return stock;
+}
+
+static bool ProteusExtensionHidden(bool webgl2, const String& name) {
+  const base::proteus::Config::WebGLCaps& caps = ProteusCaps(webgl2);
+  if (!caps.has_extensions) {
+    return false;
+  }
+  for (const std::string& offered : caps.extensions) {
+    if (DeprecatedEqualIgnoringCase(name, String::FromUtf8(offered))) {
+      return false;
+    }
+  }
+  return true;
+}
+
 bool WebGLRenderingContextBase::ExtensionSupportedAndAllowed(
     const ExtensionTracker* tracker) {
+  if (ProteusExtensionHidden(IsWebGL2(), String(tracker->ExtensionName()))) {
+    return false;
+  }
   if (tracker->Draft() &&
       !RuntimeEnabledFeatures::WebGLDraftExtensionsEnabled())
     return false;
@@ -4015,6 +4087,13 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
                                                     GLenum pname) {
   if (isContextLost())
     return ScriptValue::CreateNull(script_state->GetIsolate());
+  if (!proteus_in_stock_parameter_ &&
+      ProteusHasForcedParameter(IsWebGL2(), pname)) {
+    proteus_in_stock_parameter_ = true;
+    ScriptValue stock = getParameter(script_state, pname);
+    proteus_in_stock_parameter_ = false;
+    return ProteusForceParameter(script_state, IsWebGL2(), pname, stock);
+  }
   const int kIntZero = 0;
   switch (pname) {
     case GL_ACTIVE_TEXTURE:
@@ -4548,6 +4627,17 @@ WebGLShaderPrecisionFormat* WebGLRenderingContextBase::getShaderPrecisionFormat(
   GLint precision = 0;
   ContextGL()->GetShaderPrecisionFormat(shader_type, precision_type, range,
                                         &precision);
+  if (const std::vector<int>& forced =
+          ProteusCaps(IsWebGL2()).shader_precision;
+      forced.size() == 36) {
+    // Ordered as in proteus_config.h: vertex then fragment shader, the six
+    // precision types in the order of their GL names, three numbers each.
+    const size_t at = (shader_type == GL_VERTEX_SHADER ? 0 : 18) +
+                      (precision_type - GL_LOW_FLOAT) * 3;
+    range[0] = forced[at];
+    range[1] = forced[at + 1];
+    precision = forced[at + 2];
+  }
   return MakeGarbageCollected<WebGLShaderPrecisionFormat>(range[0], range[1],
                                                           precision);
 }
