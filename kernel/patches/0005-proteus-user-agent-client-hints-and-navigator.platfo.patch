+// Proteus: builds client hints from the active profile, if it defines them.
+static std::optional<blink::UserAgentMetadata> ProteusUserAgentMetadata(
+    bool only_low_entropy_ch) {
+  const std::optional<base::proteus::UaData>& data =
+      base::proteus::GetConfig().ua_data;
+  if (!data) {
+    return std::nullopt;
+  }
+  blink::UserAgentMetadata metadata;
+  for (const base::proteus::UaBrand& brand : data->brands) {
+    metadata.brand_version_list.emplace_back(brand.brand, brand.version);
+  }
+  metadata.mobile = data->mobile;
+  metadata.platform = data->platform;
+  if (only_low_entropy_ch) {
+    return metadata;
+  }
+  for (const base::proteus::UaBrand& brand : data->full_version_list) {
+    metadata.brand_full_version_list.emplace_back(brand.brand,
+                                                  brand.version);
+  }
+  metadata.full_version = data->full_version;
+  metadata.platform_version = data->platform_version;
+  metadata.architecture = data->architecture;
+  metadata.bitness = data->bitness;
+  metadata.model = data->model;
+  metadata.wow64 = data->wow64;
+  metadata.form_factors = {data->mobile ? "Mobile" : "Desktop"};
+  return metadata;
+}
+
 std::string GetUserAgent() {
+  if (const std::string& forced = base::proteus::GetConfig().user_agent;
+      !forced.empty()) {
+    return forced;
+  }
   std::optional<std::string> custom_ua = GetUserAgentFromCommandLine();
   if (custom_ua.has_value()) {
     return custom_ua.value();
@@ -633,6 +669,10 @@ std::string GetPlatformForUAMetadata() {
 }
 
 blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
+  if (std::optional<blink::UserAgentMetadata> forced =
+          ProteusUserAgentMetadata(only_low_entropy_ch)) {
+    return *forced;
+  }
   blink::UserAgentMetadata metadata;
 
   // Low entropy client hints.
