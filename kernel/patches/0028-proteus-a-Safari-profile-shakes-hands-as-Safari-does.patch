+// Proteus: the zlib form (RFC 8879), which is the one Safari offers.
+int DecompressZlibCert(SSL* ssl,
+                       CRYPTO_BUFFER** out,
+                       size_t uncompressed_len,
+                       const uint8_t* in,
+                       size_t in_len) {
+  uint8_t* data;
+  bssl::UniquePtr<CRYPTO_BUFFER> decompressed(
+      CRYPTO_BUFFER_alloc(&data, uncompressed_len));
+  if (!decompressed) {
+    return 0;
+  }
+  uLongf output_size = static_cast<uLongf>(uncompressed_len);
+  if (uncompress(data, &output_size, in, static_cast<uLong>(in_len)) !=
+          Z_OK ||
+      output_size != uncompressed_len) {
+    return 0;
+  }
+  *out = decompressed.release();
+  return 1;
+}
+
 }  // namespace
 
