+namespace {
+
+// Proteus: makes |headers| those of Safari. Its order; for a page load its
+// Accept, not Chrome's; and without the two headers Chrome adds to a page load
+// and Safari does not send.
+void OrderHeadersAsSafari(quiche::HttpHeaderBlock* headers) {
+  static constexpr std::string_view kOrder[] = {
+      ":method",        ":scheme",        ":authority",      ":path",
+      ":protocol",      "sec-fetch-dest", "user-agent",      "accept",
+      "sec-fetch-site", "sec-fetch-mode", "accept-language", "priority",
+      "accept-encoding",
+  };
+  std::vector<std::pair<std::string, std::string>> all;
+  for (const auto& [name, value] : *headers) {
+    if (name == "upgrade-insecure-requests" || name == "sec-fetch-user") {
+      continue;
+    }
+    if (name == "accept" && value.starts_with("text/html,")) {
+      all.emplace_back(
+          std::string(name),
+          "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8");
+      continue;
+    }
+    all.emplace_back(std::string(name), std::string(value));
+  }
+  headers->clear();
+  for (std::string_view wanted : kOrder) {
+    for (const auto& [name, value] : all) {
+      if (name == wanted) {
+        headers->insert({name, value});
+      }
+    }
+  }
+  for (const auto& [name, value] : all) {
+    if (std::ranges::find(kOrder, std::string_view(name)) ==
+        std::ranges::end(kOrder)) {
+      headers->insert({name, value});
+    }
+  }
+}
