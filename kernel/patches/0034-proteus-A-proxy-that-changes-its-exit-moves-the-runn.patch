+// Proteus: a profile's languages have moved with its place (patch 0043).
+// Every navigator of this process reads them again and is told, as when the
+// user changes the browser's languages.
+void ProteusLanguagesMovedOnWorkerThread(WorkerThread* worker_thread) {
+  DCHECK(worker_thread->IsCurrentThread());
+  if (auto* scope =
+          DynamicTo<WorkerGlobalScope>(worker_thread->GlobalScope())) {
+    scope->navigator()->NotifyUpdate();
+  }
+}
+
+void ProteusLanguagesMoved() {
+  // The event runs the page's script, which may close pages.
+  HeapVector<Member<LocalFrame>> frames;
+  for (const Page* page : Page::OrdinaryPages()) {
+    for (Frame* frame = page->MainFrame(); frame;
+         frame = frame->Tree().TraverseNext()) {
+      if (auto* local_frame = DynamicTo<LocalFrame>(frame)) {
+        frames.push_back(local_frame);
+      }
+    }
+  }
+  for (LocalFrame* frame : frames) {
+    if (LocalDOMWindow* window = frame->DomWindow()) {
+      window->AcceptLanguagesChanged();
+    }
+  }
+  WorkerThread::CallOnAllWorkerThreads(&ProteusLanguagesMovedOnWorkerThread,
+                                       TaskType::kInternalDefault);
+}
