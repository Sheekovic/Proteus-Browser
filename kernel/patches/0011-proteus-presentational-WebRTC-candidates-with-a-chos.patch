@@ -29,6 +29,7 @@
  */
 
 #include "third_party/blink/renderer/modules/peerconnection/rtc_peer_connection.h"
+#include "third_party/blink/renderer/modules/peerconnection/proteus_webrtc_spoof.h"
 
 #include <algorithm>
 #include <cstddef>
@@ -2635,6 +2636,24 @@ void RTCPeerConnection::DidFailICECandidate(const String& address,
       address, port, host_candidate, url, error_code, error_text));
 }
 
+// Proteus: |description| with the profile's presentational ICE candidates in
+// its SDP, or |description| itself when there is nothing to add.
+static RTCSessionDescription* ProteusWithIceCandidates(
+    RTCSessionDescription* description,
+    bool has_stun_or_turn_server) {
+  if (!description) {
+    return description;
+  }
+  const String sdp =
+      ProteusSdpWithIceCandidates(description->sdp(), has_stun_or_turn_server);
+  if (sdp == description->sdp()) {
+    return description;
+  }
+  return RTCSessionDescription::Create(
+      MakeGarbageCollected<RTCSessionDescriptionPlatform>(
+          description->WebSessionDescription()->GetType(), sdp));
+}
+
 void RTCPeerConnection::DidChangeSessionDescriptions(
     RTCSessionDescriptionPlatform* pending_local_description,
     RTCSessionDescriptionPlatform* current_local_description,
@@ -2658,12 +2677,36 @@ void RTCPeerConnection::DidChangeSessionDescriptions(
       current_remote_description
           ? RTCSessionDescription::Create(current_remote_description)
           : nullptr;
+  if (ice_gathering_state_ ==
+      webrtc::PeerConnectionInterface::kIceGatheringComplete) {
+    const bool has_server = !peer_handler_->GetConfiguration().servers.empty();
+    pending_local_description_ = ProteusWithIceCandidates(
+        pending_local_description_.Get(), has_server);
+    current_local_description_ = ProteusWithIceCandidates(
+        current_local_description_.Get(), has_server);
+  }
 }
 
 void RTCPeerConnection::DidChangeIceGatheringState(
     webrtc::PeerConnectionInterface::IceGatheringState new_state) {
   DCHECK(!closed_);
   DCHECK(GetExecutionContext()->IsContextThread());
+  if (new_state == webrtc::PeerConnectionInterface::kIceGatheringComplete) {
+    if (RTCSessionDescription* local = localDescription()) {
+      const bool has_server =
+          !peer_handler_->GetConfiguration().servers.empty();
+      const ProteusIceCandidates fake =
+          ProteusBuildIceCandidates(local->sdp(), has_server);
+      for (const String& candidate : fake.candidates) {
+        DidGenerateICECandidate(MakeGarbageCollected<RTCIceCandidatePlatform>(
+            candidate, fake.mid, 0, fake.username_fragment, String()));
+      }
+      pending_local_description_ = ProteusWithIceCandidates(
+          pending_local_description_.Get(), has_server);
+      current_local_description_ = ProteusWithIceCandidates(
+          current_local_description_.Get(), has_server);
+    }
+  }
   ChangeIceGatheringState(new_state);
 }
 
