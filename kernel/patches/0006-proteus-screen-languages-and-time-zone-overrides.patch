From a3694b777b39cf7fa710dbc20287492865807be9 Mon Sep 17 00:00:00 2001
From: Proteus <proteus@localhost>
Date: Sun, 15 Nov 2026 14:07:16 +0000
Subject: [PATCH 06/30] proteus: screen, languages and time zone overrides

---
 base/proteus/proteus_config.cc                | 23 +++++++++++++++++++
 base/proteus/proteus_config.h                 | 21 +++++++++++++++++
 .../net/profile_network_context_service.cc    |  6 +++++
 .../blink/renderer/core/css/media_values.cc   |  7 ++++++
 .../renderer/core/frame/navigator_language.cc | 14 ++++++++++-
 .../blink/renderer/core/frame/screen.cc       | 22 ++++++++++++++++++
 .../core/timezone/timezone_controller.cc      | 16 +++++++++++++
 7 files changed, 108 insertions(+), 1 deletion(-)

diff --git a/base/proteus/proteus_config.cc b/base/proteus/proteus_config.cc
index b6e82fd40d..8cb3f8960a 100644
--- a/base/proteus/proteus_config.cc
+++ b/base/proteus/proteus_config.cc
@@ -147,6 +147,29 @@ Config LoadConfig() {
   if (const DictValue* ua_data = dict->FindDict("uaData")) {
     config.ua_data = ParseUaData(*ua_data);
   }
+  if (const DictValue* screen = dict->FindDict("screen")) {
+    ScreenData data;
+    data.width = screen->FindInt("width").value_or(0);
+    data.height = screen->FindInt("height").value_or(0);
+    data.avail_width = screen->FindInt("availWidth").value_or(data.width);
+    data.avail_height = screen->FindInt("availHeight").value_or(data.height);
+    data.color_depth = screen->FindInt("colorDepth").value_or(24);
+    if (data.width > 0 && data.height > 0) {
+      config.screen = data;
+    }
+  }
+  if (const ListValue* languages = dict->FindList("languages")) {
+    for (const Value& language : *languages) {
+      if (!language.is_string() || language.GetString().empty()) {
+        continue;
+      }
+      if (!config.accept_languages.empty()) {
+        config.accept_languages += ",";
+      }
+      config.accept_languages += language.GetString();
+    }
+  }
+  config.timezone = StringOrEmpty(*dict, "timezone");
   config.canvas_noise = dict->FindBool("canvasNoise").value_or(false);
   config.audio_noise = dict->FindBool("audioNoise").value_or(false);
   if (const std::string* value = dict->FindString("webglVendor")) {
diff --git a/base/proteus/proteus_config.h b/base/proteus/proteus_config.h
index 453ea9c221..307b743abd 100644
--- a/base/proteus/proteus_config.h
+++ b/base/proteus/proteus_config.h
@@ -48,6 +48,16 @@ struct BASE_EXPORT UaData {
   bool wow64 = false;
 };
 
+// window.screen and the device-width / device-height media features, in CSS
+// pixels.
+struct BASE_EXPORT ScreenData {
+  int width = 0;
+  int height = 0;
+  int avail_width = 0;
+  int avail_height = 0;
+  int color_depth = 24;
+};
+
 // Per-profile identity settings. Every field is optional; an absent field means
 // "report the real value of this machine".
 struct BASE_EXPORT Config {
@@ -78,6 +88,17 @@ struct BASE_EXPORT Config {
   // User-Agent Client Hints. Absent means real.
   std::optional<UaData> ua_data;
 
+  // Screen geometry. Absent means real.
+  std::optional<ScreenData> screen;
+
+  // Preferred languages, most preferred first, comma separated ("de-DE,de,en").
+  // Drives navigator.languages and the Accept-Language header. Empty means
+  // real.
+  std::string accept_languages;
+
+  // IANA time zone id ("America/New_York"). Empty means real.
+  std::string timezone;
+
   // Whether canvas readbacks (2D and WebGL) carry seed-derived noise.
   bool canvas_noise = false;
 
