 #include "third_party/blink/public/common/features.h"
@@ -105,6 +110,17 @@ TimeZoneController::~TimeZoneController() = default;
 
 // static
 void TimeZoneController::Init() {
+  if (const std::string& forced = base::proteus::GetConfig().timezone;
+      !forced.empty()) {
+    std::unique_ptr<icu::TimeZone> zone(icu::TimeZone::createTimeZone(
+        icu::UnicodeString::fromUTF8(forced)));
+    if (zone && *zone != icu::TimeZone::getUnknown()) {
+      base::AutoLock locker(instance().lock_);
+      icu::TimeZone::adoptDefault(zone.release());
+      instance().override_timezone_id_ =
+          String::FromUtf8(base::as_byte_span(forced));
+    }
+  }
   if (base::CommandLine::ForCurrentProcess()->HasSwitch(
           blink::switches::kTopChromeWebUI) &&
       base::FeatureList::IsEnabled(features::kWebUIBypassMojoConnections)) {
