@@ -107,11 +115,12 @@ static bool ProteusFillVoiceList(
 
 void SpeechSynthesis::OnSetVoiceList(
     Vector<mojom::blink::SpeechSynthesisVoicePtr> mojom_voices) {
-  voice_list_.clear();
-  if (ProteusFillVoiceList(voice_list_)) {
-    VoicesDidChange();
+  if (!base::proteus::GetConfig().voices.empty()) {
+    // The machine's list is not the profile's, and its arrival is not the
+    // moment the profile's voices arrive: ProteusDeliverVoices() is.
     return;
   }
+  voice_list_.clear();
   for (auto& mojom_voice : mojom_voices) {
     voice_list_.push_back(
         MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
@@ -122,12 +131,30 @@ void SpeechSynthesis::OnSetVoiceList(
 const HeapVector<Member<SpeechSynthesisVoice>>& SpeechSynthesis::getVoices() {
   // Kick off initialization here to ensure voice list gets populated.
   std::ignore = TryEnsureMojomSynthesis();
-  if (voice_list_.empty()) {
-    ProteusFillVoiceList(voice_list_);
+  if (!proteus_voices_asked_for_ &&
+      !base::proteus::GetConfig().voices.empty() && GetSupplementable()) {
+    proteus_voices_asked_for_ = true;
+    GetSupplementable()
+        ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostDelayedTask(FROM_HERE,
+                          BindOnce(&SpeechSynthesis::ProteusDeliverVoices,
+                                   WrapWeakPersistent(this)),
+                          base::Milliseconds(12));
   }
   return voice_list_;
 }
 
+// Proteus: the profile's voices arrive, as a browser's do: after the page asked,
+// with one voiceschanged event.
+void SpeechSynthesis::ProteusDeliverVoices() {
+  if (!voice_list_.empty() || !GetSupplementable()) {
+    return;
+  }
+  if (ProteusFillVoiceList(voice_list_)) {
+    VoicesDidChange();
+  }
+}
