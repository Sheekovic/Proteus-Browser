 #include "base/stl_util.h"
 #include "base/strings/strcat.h"
 #include "base/strings/string_number_conversions.h"
@@ -3097,6 +3098,13 @@ void ChromeContentBrowserClient::AppendExtraCommandLineSwitches(
     base::CommandLine* command_line,
     int child_process_id) {
   crash_keys::AppendStringAnnotationsCommandLineSwitch(command_line);
+  if (const base::proteus::Config& proteus_config =
+          base::proteus::GetConfig();
+      proteus_config.active &&
+      !command_line->HasSwitch(base::proteus::kConfigDataSwitch)) {
+    command_line->AppendSwitchASCII(base::proteus::kConfigDataSwitch,
+                                    proteus_config.serialized);
+  }
 #if BUILDFLAG(IS_MAC)
   std::unique_ptr<metrics::ClientInfo> client_info =
       GoogleUpdateSettings::LoadMetricsClientInfo();
diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
index f5c0db2d1b..5ebaa4e6d3 100644
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -4,11 +4,16 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
+#include "base/proteus/proteus_config.h"
 #include "base/system/sys_info.h"
 
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  if (const auto& forced =
+          base::proteus::GetConfig().hardware_concurrency) {
+    return static_cast<unsigned>(*forced);
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
