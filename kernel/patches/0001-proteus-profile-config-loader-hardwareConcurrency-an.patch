diff --git a/base/proteus/proteus_config.cc b/base/proteus/proteus_config.cc
new file mode 100644
index 0000000000..70bd43a395
--- /dev/null
+++ b/base/proteus/proteus_config.cc
@@ -0,0 +1,118 @@
+// Copyright 2026 The Proteus Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/proteus/proteus_config.h"
+
+#include <string_view>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+
+namespace base::proteus {
+
+const char kConfigFileSwitch[] = "proteus-config";
+const char kConfigDataSwitch[] = "proteus-config-data";
+
+namespace {
+
+// Profile configurations are small; refuse anything implausibly large.
+constexpr size_t kMaxConfigBytes = 1024 * 1024;
+
+// Returns the raw JSON for this process, or an empty string if none was given.
+std::string ReadConfigJson() {
+  if (!CommandLine::InitializedForCurrentProcess()) {
+    return std::string();
+  }
+  const CommandLine& command_line = *CommandLine::ForCurrentProcess();
+
+  if (command_line.HasSwitch(kConfigDataSwitch)) {
+    std::optional<std::vector<uint8_t>> decoded =
+        Base64Decode(command_line.GetSwitchValueASCII(kConfigDataSwitch));
+    if (!decoded) {
+      LOG(ERROR) << "Proteus: malformed --" << kConfigDataSwitch;
+      return std::string();
+    }
+    return std::string(decoded->begin(), decoded->end());
+  }
+
+  if (command_line.HasSwitch(kConfigFileSwitch)) {
+    const FilePath path = command_line.GetSwitchValuePath(kConfigFileSwitch);
+    std::string json;
+    if (!ReadFileToStringWithMaxSize(path, &json, kMaxConfigBytes)) {
+      LOG(ERROR) << "Proteus: cannot read config file " << path;
+      return std::string();
+    }
+    return json;
+  }
+
+  return std::string();
+}
+
+// The seed may be written as a JSON number or, to keep all 64 bits, a string.
+uint64_t ParseSeed(const DictValue& dict) {
+  if (const std::string* text = dict.FindString("seed")) {
+    uint64_t seed = 0;
+    if (StringToUint64(*text, &seed)) {
+      return seed;
+    }
+    return 0;
+  }
+  if (std::optional<double> number = dict.FindDouble("seed")) {
+    return *number > 0 ? static_cast<uint64_t>(*number) : 0;
+  }
+  return 0;
+}
+
+Config LoadConfig() {
+  Config config;
+  const std::string json = ReadConfigJson();
+  if (json.empty()) {
+    return config;
+  }
+
+  std::optional<DictValue> dict = JSONReader::ReadDict(json, JSON_PARSE_RFC);
+  if (!dict) {
+    LOG(ERROR) << "Proteus: config is not a JSON object";
+    return config;
+  }
+
+  config.active = true;
+  config.seed = ParseSeed(*dict);
+  // The zygote is launched before base::FeatureList exists, so the regular
+  // Base64Encode(), which consults a feature, must not be used here.
+  config.serialized = Base64EncodeEarlyStartup(as_byte_span(json));
+
+  if (std::optional<int> value = dict->FindInt("hardwareConcurrency");
+      value && *value > 0) {
+    config.hardware_concurrency = *value;
+  }
+  if (std::optional<double> value = dict->FindDouble("deviceMemory");
+      value && *value > 0) {
+    config.device_memory = *value;
+  }
+  return config;
+}
+
+}  // namespace
+
+Config::Config() = default;
+Config::Config(const Config&) = default;
+Config& Config::operator=(const Config&) = default;
+Config::~Config() = default;
+
+const Config& GetConfig() {
+  static const NoDestructor<Config> config(LoadConfig());
+  return *config;
+}
+
+}  // namespace base::proteus
diff --git a/base/proteus/proteus_config.h b/base/proteus/proteus_config.h
new file mode 100644
index 0000000000..ddcfe54110
--- /dev/null
+++ b/base/proteus/proteus_config.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The Proteus Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_PROTEUS_PROTEUS_CONFIG_H_
+#define BASE_PROTEUS_PROTEUS_CONFIG_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+
+#include "base/base_export.h"
+
+namespace base::proteus {
+
+// --proteus-config=<path>: JSON profile configuration. Read once by the browser
+// process, which is the only process allowed to touch the file system.
+BASE_EXPORT extern const char kConfigFileSwitch[];
+
+// --proteus-config-data=<base64 JSON>: the same configuration, handed by the
+// browser process to every child process it launches.
+BASE_EXPORT extern const char kConfigDataSwitch[];
+
+// Per-profile identity settings. Every field is optional; an absent field means
+// "report the real value of this machine".
+struct BASE_EXPORT Config {
+  Config();
+  Config(const Config&);
+  Config& operator=(const Config&);
+  ~Config();
+
+  // True when a configuration was supplied and parsed successfully.
+  bool active = false;
+
+  // Stable per-profile seed for deterministic noise.
+  uint64_t seed = 0;
+
+  // navigator.hardwareConcurrency
+  std::optional<int> hardware_concurrency;
+
+  // navigator.deviceMemory, in GiB.
+  std::optional<double> device_memory;
+
+  // Base64 form of the source JSON, forwarded to child processes.
+  std::string serialized;
+};
+
+// Returns the configuration of the current process. Parsed on first use and
+// immutable afterwards; safe to call from any thread.
+BASE_EXPORT const Config& GetConfig();
+
+}  // namespace base::proteus
+
+#endif  // BASE_PROTEUS_PROTEUS_CONFIG_H_
