+// Proteus: removes the members the profile's browser does not have.
+static void ProteusHideWindowMembers(v8::Isolate* isolate,
+    v8::Local<v8::Context> context) {
+  const auto& hidden = base::proteus::GetConfig().hidden_members;
+  if (hidden.empty()) {
+    return;
+  }
+  v8::HandleScope handle_scope(isolate);
+  v8::Context::Scope context_scope(context);
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::String> prototype_key =
+      v8::String::NewFromUtf8Literal(isolate, "prototype");
+  for (const auto& entry : hidden) {
+    v8::Local<v8::String> name;
+    v8::Local<v8::Value> constructor;
+    v8::Local<v8::Value> prototype;
+    if (!v8::String::NewFromUtf8(isolate, entry.interface_name.c_str())
+             .ToLocal(&name) ||
+        !context->Global()->Get(context, name).ToLocal(&constructor) ||
+        !constructor->IsObject() ||
+        !constructor.As<v8::Object>()
+             ->Get(context, prototype_key)
+             .ToLocal(&prototype) ||
+        !prototype->IsObject()) {
+      continue;
+    }
+    for (const std::string& member : entry.members) {
+      v8::Local<v8::String> key;
+      if (v8::String::NewFromUtf8(isolate, member.c_str()).ToLocal(&key)) {
+        std::ignore = prototype.As<v8::Object>()->Delete(context, key);
+      }
+    }
+  }
+}
+
 void LocalWindowProxy::Initialize() {
   TRACE_EVENT2("v8", "LocalWindowProxy::Initialize", "IsMainFrame",
                GetFrame()->IsMainFrame(), "IsOutermostMainFrame",
@@ -309,6 +346,12 @@ void LocalWindowProxy::Initialize() {
