diff --git a/base/proteus/proteus_config.cc b/base/proteus/proteus_config.cc
index 70fb86f009..4adf08be99 100644
--- a/base/proteus/proteus_config.cc
+++ b/base/proteus/proteus_config.cc
@@ -217,6 +217,28 @@ Config LoadConfig() {
       config.mobile_view_height = height;
       config.mobile_device_scale_factor = scale;
       config.mobile_max_touch_points = touch;
+      config.mobile_pdf_viewer = mobile->FindBool("pdfViewer").value_or(false);
+    }
+  }
+  config.vendor = StringOrEmpty(*dict, "vendor");
+  config.client_hints = dict->FindBool("clientHints").value_or(true);
+  config.chrome_object = dict->FindBool("chromeObject").value_or(true);
+  if (const DictValue* hide = dict->FindDict("hide")) {
+    for (const auto [interface_name, value] : *hide) {
+      const ListValue* list = value.GetIfList();
+      if (interface_name.empty() || !list) {
+        continue;
+      }
+      Config::HiddenMembers hidden;
+      hidden.interface_name = interface_name;
+      for (const Value& member : *list) {
+        if (member.is_string() && !member.GetString().empty()) {
+          hidden.members.push_back(member.GetString());
+        }
+      }
+      if (!hidden.members.empty()) {
+        config.hidden_members.push_back(std::move(hidden));
+      }
     }
   }
   if (const DictValue* geo = dict->FindDict("geolocation")) {
diff --git a/base/proteus/proteus_config.h b/base/proteus/proteus_config.h
index 1b4b894460..cfb13f2c12 100644
--- a/base/proteus/proteus_config.h
+++ b/base/proteus/proteus_config.h
@@ -185,6 +185,23 @@ struct BASE_EXPORT Config {
   double mobile_device_scale_factor = 2.0;
   int mobile_view_width = 0;
   int mobile_view_height = 0;
+  // Phones other than Android ones keep the built-in PDF viewer plugins.
+  bool mobile_pdf_viewer = false;
+
+  // Identity of a browser from another vendor. |vendor| replaces
+  // navigator.vendor when not empty. |hidden_members| lists, per interface
+  // name ("Navigator", "WorkerNavigator", ...), members that browser does not
+  // have; they are removed from the interface in every script context.
+  // |client_hints| false sends no client hint request headers at all and
+  // |chrome_object| false leaves pages without window.chrome.
+  struct HiddenMembers {
+    std::string interface_name;
+    std::vector<std::string> members;
+  };
+  std::string vendor;
+  std::vector<HiddenMembers> hidden_members;
+  bool client_hints = true;
+  bool chrome_object = true;
 
   bool has_geolocation = false;
   double geolocation_latitude = 0;
