+                    !document->Url().ProtocolIs("chrome-untrusted") &&
+                    !document->Url().ProtocolIs("devtools"))) {
+    ProteusHideWindowMembers(script_state_->GetIsolate(), context);
+  }
 
   if (World().IsMainWorld()) {
     probe::DidCreateMainWorldContext(GetFrame());
