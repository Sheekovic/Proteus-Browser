 #include "gin/converter.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "url/gurl.h"
 #include "v8/include/v8-context.h"
 #include "v8/include/v8-object.h"
 
@@ -12,6 +17,15 @@ namespace content {
 
 v8::Local<v8::Object> GetOrCreateChromeObject(v8::Isolate* isolate,
                                               v8::Local<v8::Context> context) {
+  if (!base::proteus::GetConfig().chrome_object) {
+    blink::WebLocalFrame* frame =
+        blink::WebLocalFrame::FrameForContext(context);
+    const GURL url = frame ? GURL(frame->GetDocument().Url()) : GURL();
+    if (!url.SchemeIs("chrome") && !url.SchemeIs("chrome-untrusted") &&
+        !url.SchemeIs("devtools")) {
+      return v8::Object::New(isolate);
+    }
+  }
   return GetOrCreateObject(isolate, context, "chrome");
 }
 
